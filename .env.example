# Base URL used directly by src/services/api.js (bypasses the vite dev proxy).
# Defaults to http://localhost:7002 when the backend runs on the same machine.
# For LAN testing (e.g. from a phone), set this to your machine's LAN IP:
# VITE_API_URL=http://192.168.x.x:7002
VITE_API_URL=http://localhost:7002

# Target used by the vite dev server's /api proxy (see vite.config.js), used
# by src/utils/Api.js. Same override rule as above.
VITE_PROXY_TARGET=http://localhost:7002
